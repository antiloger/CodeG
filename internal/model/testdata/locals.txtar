package m

var handler = func(a int) int {
	x := a
	return x
}

var pair1, pair2 = func() {}, func() {}

func shadow(x int, _ string, y ...int) (n int, err error) {
	x2 := x
	if x := x + 1; x > 0 {
		x := x * 2
		_ = x
	}
	for i := 0; i < 3; i++ {
		i := i
		_ = i
	}
	{
		x := "inner"
		_ = x
	}
	_ = x2
	return
}

func closures() {
	a := 1
	f := func(p int) func() int {
		b := p + a
		return func() int {
			b := b + 1
			return b
		}
	}
	g := func() {}
	_, _ = f, g
	defer func() {}()
	go func() { a++ }()
}

func typeSwitch(v any) {
	switch x := v.(type) {
	case int:
		_ = x
	case string, bool:
		_ = x
	default:
		_ = x
	}
}

func localTypes() {
	type T struct {
		A int
		B string
	}
	type I interface{ M() int }
	const c = 3
	type T2 = T
	t := T{A: c}
	_ = t.A
	var i I
	_ = i.M()
	anon := struct{ Q, R int }{1, 2}
	_ = anon.Q
	{
		type T struct{ A bool }
		_ = T{}.A
	}
}

func labels(xs [][]int) int {
	n := 0
outer:
	for _, row := range xs {
		for _, v := range row {
			if v < 0 {
				continue outer
			}
			if v == 0 {
				goto done
			}
			n += v
		}
	}
done:
	return n
}

func multi() {
	x := 1
	_ = x
}

func multi2() {
	x := 2
	_ = x
}
