-- go.mod --
module example.com/m

go 1.24
-- lib/lib.go --
package lib

import "io"

type Base struct{ ID int }

func (b *Base) Touch() {}
func (b Base) Name() string { return "" }

type Wrapper struct {
	Base
	Extra struct{ Deep struct{ N int } }
}

type Store[K comparable, V any] struct{ m map[K]V }

func (s *Store[K, V]) Put(k K, v V) {}

type ReadCloser interface {
	io.Reader
	Close() error
}

type Cfg struct{ A int }
type Cfg2 Cfg

var Default = struct{ Port int }{80}

func Apply[T interface{ Set(int) }](t T) { t.Set(1) }
-- app/app.go --
package app

import (
	"errors"

	"example.com/m/lib"
)

type Mine struct {
	*lib.Wrapper
}

type setter struct{}

func (setter) Set(int) {}

func run(rc lib.ReadCloser, m Mine) error {
	m.Touch()
	_ = m.Name()
	_ = m.ID
	_ = m.Extra.Deep.N
	s := lib.Store[string, int]{}
	s.Put("a", 1)
	_ = rc.Close()
	_, _ = rc.Read(nil)
	c := lib.Cfg2{A: 1}
	_ = c.A
	_ = lib.Default.Port
	lib.Apply(setter{})
	err := errors.New("x")
	return err
}

func errMethod(e error) string { return e.Error() }
