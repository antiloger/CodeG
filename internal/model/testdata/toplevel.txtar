-- a.go --
package m

import "fmt"

const Answer = 42
const _ = 1

var Global = 1
var _ = fmt.Sprint
var _ interface{ Pointer() } = (*T)(nil)

type T struct {
	Name string
	_    int
	_    int
	Embedded
	*Ptr
	Anon struct{ X, Y int }
}

type Embedded struct{ E int }
type Ptr struct{ P int }

type Reader interface {
	Read() int
	fmt.Stringer
}

func New() *T { return &T{} }

func (t T) Value() string { return t.Name }

func (t *T) Pointer() { t.Name = "x"; t.E = 1; t.P = 2; t.Anon.X = 3 }

func (Embedded) Promoted() {}

func init() {}
func init() {}
func _()    {}

func use(r Reader, t *T) {
	_ = r.Read()
	t.Promoted()
	_ = Global + Answer
}

type Alias = T
type Copy T
