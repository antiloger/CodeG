-- go.mod --
module example.com/m

go 1.24
-- g.go --
package m

type Box[T any] struct {
	Val  T
	Next *Box[T]
}

func (b *Box[T]) Get() T { return b.Val }

func (b Box[U]) Swap(other Box[U]) Box[U] { return other }

func (b Box[_]) Blank() {}

func Map[A, B any](xs []A, f func(A) B) []B {
	var out []B
	for _, x := range xs {
		out = append(out, f(x))
	}
	return out
}

func Pair[_, _ any]() {}

type Number interface{ ~int | ~float64 }

func Sum[N Number](xs ...N) N {
	var s N
	for _, x := range xs {
		s += x
	}
	return s
}

type Ord[T interface{ Less(T) bool }] struct{ v T }

type IntBox = Box[int]

type GAlias[T any] = Box[T]

func use() {
	b := Box[int]{Val: 1}
	_ = b.Get()
	_ = b.Swap(b)
	_ = Map[int, string](nil, nil)
	_ = Sum(1, 2, 3)
	var ib IntBox
	_ = ib.Val
	var ga GAlias[string]
	_ = ga.Next
}
