-- go.mod --
module example.com/m

go 1.24
-- c.go --
package m

import (
	"fmt"
	"sync"
)

type User struct{ Name string }

type Store interface{ Save(u *User) error }

type memStore struct{ users []*User }

func (s *memStore) Save(u *User) error { s.users = append(s.users, u); return nil }

// CreateUser is the "handler" example: build, persist, return.
func CreateUser(st Store, name string) (*User, error) {
	u := &User{Name: name}
	if err := st.Save(u); err != nil {
		return nil, err
	}
	return u, nil
}

func foo(a int) int {
	b := a
	bar(b, a)
	return b
}

func bar(x, y int) {}

func Map[A, B any](xs []A, f func(A) B) []B {
	var out []B
	for _, x := range xs {
		out = append(out, f(x))
	}
	return out
}

func dispatch(st Store, fn func(int), fns []func(), m map[string]func()) {
	st.Save(nil)
	fn(1)
	fns[0]()
	m["k"]()
	getFn()()
	func() { fmt.Println("iife") }()
	handler := foo
	_ = handler
	_ = Map[int, string](nil, nil)
	_ = Map(nil, func(int) string { return "" })
}

func getFn() func() { return nil }

func concurrency(mu *sync.Mutex, ch chan int) {
	total := 0
	mu.Lock()
	defer mu.Unlock()
	defer func() { total++ }()
	go func() {
		total += 1
		ch <- total
	}()
	go bar(1, 2)
	for i := 0; i < 3; i++ {
		if i > 1 && total > 0 {
			bar(i, total)
		}
		switch i {
		case 0:
			bar(0, 0)
		}
		func() { total-- }()
	}
	_ = memStore{}.users
}
