-- m.go --
package m

import _ "embed"

type T struct{ n int }

func (t *T) Inc()      { t.n++ }
func (t T) Get() int   { return t.n }

type Wrapper struct{ *T }

var _ = T{}

var hook = func(x int) int {
	y := x
	return y
}

func init() { hook(1) }
func init() { hook(2) }

func values(t T, w Wrapper) {
	f := t.Get      // method value
	g := T.Get      // method expression
	h := (*T).Inc   // method expression on pointer type
	i := t.Inc      // method value with pointer receiver: implicit &t
	w.Inc()         // promoted through an embedded pointer
	_, _, _, _ = f, g, h, i
}

type Holder struct{ v T }

func nested(p *Holder) {
	p.v.Inc() // implicit &p.v: p and v address_taken
	_ = p.v.Get()
}

func labels(xs [][]int) int {
	n := 0
outer:
	for _, row := range xs {
		for _, v := range row {
			if v < 0 {
				continue outer
			}
			if v == 0 {
				goto done
			}
			n += v
		}
	}
done:
	return n
}

func kinds(v any) string {
	switch x := v.(type) {
	case int:
		return string(rune(x))
	case *T:
		x.Inc()
		return ""
	}
	return ""
}
