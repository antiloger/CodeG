-- go.mod --
module example.com/m

go 1.24
-- s.go --
package m

import (
	"fmt"
	str "strings"
)

type Shape interface {
	Area() float64
	fmt.Stringer
}

type Base struct{ ID int }

func (b *Base) SetID(id int) { b.ID = id }

type Circle struct {
	Base
	R    float64
	Meta struct{ Tag string }
}

func (c Circle) Area() float64  { return c.R }
func (c Circle) String() string { return str.ToUpper("circle") }

type Alias = Circle

type List[T any] struct{ items []T }

func (l *List[T]) Add(v T) { l.items = append(l.items, v) }

const Pi = 3.14

var Default Shape = Circle{}

func Describe(s Shape, extra ...string) (desc string, err error) {
	type local struct{ n int }
	f := func(x int) int { return x }
	_ = f
	return s.String(), nil
}
