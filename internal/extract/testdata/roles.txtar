module example.com/m

go 1.24
-- r.go --
package m

type Point struct{ X, Y int }

type Line struct {
	A, B Point
	Tags []string
}

func (p *Point) Move(dx int) { p.X += dx }
func (p Point) Len() int     { return p.X }

var counter int

func roles(l Line, pp *Point, m map[string]int, xs []int) {
	var v Point
	v = Point{X: 1, Y: 2} // whole overwrite, keyed construct
	v.X = 3               // partial write of v, write of X
	l.A.Y = 4             // nested: l and A partial, Y write
	xs[0] = 5             // xs partial
	m["k"] = 6            // m partial
	counter++             // read_write
	counter += 2          // read_write
	*pp = v               // pp is read: the write target is unknown
	pp.X = 7              // pp partial (pointer root), X write

	p := &v      // address_taken
	q := &l.B.X  // address_taken on l, B, X
	v.Move(1)    // implicit &v
	pp.Move(1)   // pp is already a pointer: read
	_ = v.Len()  // value receiver: read
	_, _ = p, q

	np := new(Point)         // construct
	lp := &Line{Tags: nil}   // construct + init key
	var s Line               // type_use
	ps := []Point{{X: 1}}    // type_use in a slice literal, not construct
	_, _, _, _ = np, lp, s, ps

	for i := range xs { // define i
		xs[i] = i
	}
	for i = 0; false; {
	}
}

var i int
